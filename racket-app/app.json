{
  "expo": {
    "name": "Shadow Racket",
    "slug": "shadow-racket",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.shadow.racket"
    },
    "plugins": [
      [
        "expo-sensors",
        {
          "motionPermission": "Shadow reads the phone's motion so the phone can act as the racket. Nothing leaves your local network."
        }
      ]
    ]
  }
}
